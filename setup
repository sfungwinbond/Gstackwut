#!/usr/bin/env bash

set -uo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  printf 'WutPack setup currently supports macOS only.\n' >&2
  exit 1
fi

PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
USER_HOME="${WUTPACK_TEST_ROOT:-$HOME}"
STATE_ROOT="${WUTPACK_STATE_ROOT:-$USER_HOME/Library/Application Support/WutPack}"
CACHE_ROOT="${WUTPACK_CACHE_ROOT:-$USER_HOME/Library/Caches/WutPack}"
LOCAL_BIN="${WUTPACK_BIN_DIR:-$USER_HOME/.local/bin}"
KNOWLEDGE_ENV="$STATE_ROOT/knowledge"
AGENT_ENV="$STATE_ROOT/agents"
NODE_PREFIX="$STATE_ROOT/npm-global"
TEMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/wutpack-setup.XXXXXX")"

PROFILE="full"
HOST="auto"
DRY_RUN=0
SKILLS_ONLY=0
SKIP_CASKS=0
SKIP_AI_CLIS=0
WITH_EXTRAS=0
FAILURES=()
SETUP_LOCK_ROOT=""
HAVE_SETUP_LOCK=0
EXPECTED_SKILLS=(
  code-build
  data-lab
  debug-lab
  document-studio
  pdf-forensics
  publish-docs
  research-brief
  review-gate
  ship-check
  spreadsheet-lab
  system-diagram
  technical-deck
)

cleanup() {
  if [ "$HAVE_SETUP_LOCK" -eq 1 ]; then
    rm -f -- "$SETUP_LOCK_ROOT/pid" "$SETUP_LOCK_ROOT/start"
    rmdir "$SETUP_LOCK_ROOT" 2>/dev/null || true
  fi
  case "$TEMP_ROOT" in
    "${TMPDIR:-/tmp}"/wutpack-setup.*) rm -rf -- "$TEMP_ROOT" ;;
  esac
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
  cat <<'EOF'
Usage: ./setup [options]

  --host auto|codex|claude|both  Install scenario skills for detected host(s)
  --profile core|full            Core is lighter; full adds ML and agent stacks
  --skills-only                  Install the CLI and skills, no packages
  --skip-casks                   Skip desktop applications
  --skip-ai-clis                 Skip Codex and Claude Code CLI installation
  --with-extras                  Add optional local-AI/container applications
  --dry-run                      Print package actions without running them
  -h, --help                     Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host)
      [ "$#" -ge 2 ] || { printf 'Missing value for --host\n' >&2; exit 2; }
      HOST="$2"
      shift 2
      ;;
    --host=*) HOST="${1#*=}"; shift ;;
    --profile)
      [ "$#" -ge 2 ] || { printf 'Missing value for --profile\n' >&2; exit 2; }
      PROFILE="$2"
      shift 2
      ;;
    --profile=*) PROFILE="${1#*=}"; shift ;;
    --skills-only) SKILLS_ONLY=1; shift ;;
    --skip-casks) SKIP_CASKS=1; shift ;;
    --skip-ai-clis) SKIP_AI_CLIS=1; shift ;;
    --with-extras) WITH_EXTRAS=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

case "$HOST" in auto|codex|claude|both) ;; *) printf 'Invalid host: %s\n' "$HOST" >&2; exit 2 ;; esac
case "$PROFILE" in core|full) ;; *) printf 'Invalid profile: %s\n' "$PROFILE" >&2; exit 2 ;; esac

say() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
note() { printf '    %s\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }

fatal() {
  printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2
  exit 1
}

record_failure() {
  FAILURES+=("$1")
  warn "$1"
  if [ "${GITHUB_ACTIONS:-}" = "true" ]; then
    printf '::error title=WutPack setup::%s\n' "$1"
  fi
}

validate_source_tree() {
  local required_file
  local skill_name
  local skill_dir
  local skill_count=0

  for required_file in \
    VERSION install.sh setup bin/wut \
    manifests/brew-formulae.txt manifests/brew-casks.txt \
    manifests/brew-extras.txt manifests/node-tools.txt \
    manifests/node-agents.txt manifests/node-retired.txt \
    manifests/python-core.txt manifests/python-ml.txt \
    manifests/python-agents.txt \
    skills/technical-deck/scripts/new_technical_deck.mjs; do
    [ -f "$PROJECT_ROOT/$required_file" ] || \
      fatal "WutPack source is incomplete: missing $required_file"
  done

  for skill_name in "${EXPECTED_SKILLS[@]}"; do
    [ -f "$PROJECT_ROOT/skills/$skill_name/SKILL.md" ] || \
      fatal "WutPack source is incomplete: missing skill $skill_name"
  done

  for skill_dir in "$PROJECT_ROOT"/skills/*; do
    [ -d "$skill_dir" ] || continue
    case "$(basename "$skill_dir")" in
      code-build|data-lab|debug-lab|document-studio|pdf-forensics|publish-docs|research-brief|review-gate|ship-check|spreadsheet-lab|system-diagram|technical-deck)
        skill_count=$((skill_count + 1))
        ;;
      *) fatal "WutPack source contains an unexpected skill: $(basename "$skill_dir")" ;;
    esac
  done
  [ "$skill_count" -eq "${#EXPECTED_SKILLS[@]}" ] || \
    fatal "WutPack source is incomplete: found $skill_count/${#EXPECTED_SKILLS[@]} required skills"
}

preflight_command_target() {
  local target="$LOCAL_BIN/wut"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    fatal "Cannot install wut because a non-symlink already exists: $target"
  fi
}

setup_process_start_time() {
  ps -p "$1" -o lstart= 2>/dev/null | \
    sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

write_setup_lock_owner() {
  local lock_dir="$1"
  local start_time
  start_time="$(setup_process_start_time "$$" || true)"
  [ -n "$start_time" ] || start_time="unavailable"
  printf '%s\n' "$$" > "$lock_dir/pid" || return 1
  printf '%s\n' "$start_time" > "$lock_dir/start" || return 1
}

setup_lock_owner_status() {
  local lock_dir="$1"
  local owner_pid
  local owner_start
  local current_start

  [ -f "$lock_dir/pid" ] && [ -f "$lock_dir/start" ] || return 2
  IFS= read -r owner_pid < "$lock_dir/pid" || return 2
  case "$owner_pid" in ''|*[!0-9]*) return 2 ;; esac
  IFS= read -r owner_start < "$lock_dir/start" || return 2
  [ -n "$owner_start" ] || return 2
  kill -0 "$owner_pid" 2>/dev/null || return 1
  current_start="$(setup_process_start_time "$owner_pid" || true)"
  if [ "$owner_start" = "unavailable" ] || [ -z "$current_start" ]; then
    return 0
  fi
  [ "$current_start" = "$owner_start" ]
}

is_safe_setup_lock_dir() {
  local lock_dir="$1"
  local owner_uid
  local lock_mode

  [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] || return 1
  owner_uid="$(stat -f '%u' "$lock_dir" 2>/dev/null)" || return 1
  lock_mode="$(stat -f '%Lp' "$lock_dir" 2>/dev/null)" || return 1
  [ "$owner_uid" = "$(id -u)" ] && [ "$lock_mode" = "700" ]
}

acquire_setup_lock() {
  local project_parent
  local project_name
  local owner_state=0
  local recovery_state=0
  local recovery_dir

  [ "$DRY_RUN" -eq 0 ] || return 0
  project_parent="$(CDPATH= cd -- "$PROJECT_ROOT/.." && pwd -P)" || \
    fatal "Could not resolve WutPack source parent: $PROJECT_ROOT"
  project_name="$(basename -- "$PROJECT_ROOT")"
  SETUP_LOCK_ROOT="$project_parent/.$project_name.install-lock"

  if [ "${WUTPACK_INSTALL_LOCK_HELD:-}" = "$SETUP_LOCK_ROOT" ] && \
    [ -d "$SETUP_LOCK_ROOT" ]; then
    return 0
  fi
  if mkdir -m 700 "$SETUP_LOCK_ROOT" 2>/dev/null; then
    HAVE_SETUP_LOCK=1
    write_setup_lock_owner "$SETUP_LOCK_ROOT" || \
      fatal "Could not initialize the WutPack setup lock: $SETUP_LOCK_ROOT"
    return 0
  fi
  is_safe_setup_lock_dir "$SETUP_LOCK_ROOT" || \
    fatal "Unsafe WutPack setup lock at $SETUP_LOCK_ROOT; refusing recovery"

  setup_lock_owner_status "$SETUP_LOCK_ROOT" || owner_state=$?
  case "$owner_state" in
    0) fatal "Another WutPack install or setup is active (lock: $SETUP_LOCK_ROOT)" ;;
    2) fatal "Unreadable WutPack setup lock at $SETUP_LOCK_ROOT; verify no setup is running, then remove it" ;;
  esac
  if [ -f "$SETUP_LOCK_ROOT/stage" ] || \
    [ -f "$SETUP_LOCK_ROOT/backup" ] || \
    [ -f "$SETUP_LOCK_ROOT/had-previous" ]; then
    fatal "An interrupted WutPack source update needs recovery; re-run wut update"
  fi

  recovery_dir="$SETUP_LOCK_ROOT/recovery"
  if [ -d "$recovery_dir" ]; then
    is_safe_setup_lock_dir "$recovery_dir" || \
      fatal "Unsafe WutPack setup recovery lock at $recovery_dir"
    setup_lock_owner_status "$recovery_dir" || recovery_state=$?
    case "$recovery_state" in
      0) fatal "Another WutPack process is recovering the setup lock" ;;
      1)
        rm -f -- "$recovery_dir/pid" "$recovery_dir/start"
        rmdir "$recovery_dir" 2>/dev/null || \
          fatal "Could not reclaim stale setup recovery lock: $recovery_dir"
        ;;
      *) fatal "Unreadable WutPack setup recovery lock at $recovery_dir" ;;
    esac
  fi

  mkdir -m 700 "$recovery_dir" 2>/dev/null || \
    fatal "Another WutPack process claimed setup recovery"
  write_setup_lock_owner "$recovery_dir" || \
    fatal "Could not initialize WutPack setup recovery"
  rm -f -- "$SETUP_LOCK_ROOT/pid" "$SETUP_LOCK_ROOT/start"
  rm -f -- "$recovery_dir/pid" "$recovery_dir/start"
  rmdir "$recovery_dir" || fatal "Could not finish WutPack setup lock recovery"
  HAVE_SETUP_LOCK=1
  write_setup_lock_owner "$SETUP_LOCK_ROOT" || \
    fatal "Could not initialize the WutPack setup lock: $SETUP_LOCK_ROOT"
}

run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY RUN:'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

run_required() {
  local label="$1"
  shift
  run "$@" || fatal "$label"
}

run_checked() {
  local label="$1"
  shift
  if ! run "$@"; then
    record_failure "$label"
    return 1
  fi
}

find_brew() {
  local candidate
  local default_bin

  candidate="$(command -v brew 2>/dev/null || true)"
  if [ -n "$candidate" ] && brew_matches_hardware "$candidate"; then
    printf '%s\n' "$candidate"
    return 0
  fi

  if [ "$(homebrew_hardware_arch)" = "arm64" ]; then
    default_bin="/opt/homebrew/bin/brew"
  else
    default_bin="/usr/local/bin/brew"
  fi
  if [ -x "$default_bin" ]; then
    printf '%s\n' "$default_bin"
    return 0
  fi
  return 1
}

homebrew_hardware_arch() {
  local machine

  if [ -n "${WUTPACK_TEST_ROOT:-}" ] && \
    [ -n "${WUTPACK_TEST_HARDWARE_ARCH:-}" ]; then
    machine="$WUTPACK_TEST_HARDWARE_ARCH"
  else
    machine="$(uname -m)"
    if [ "$machine" = "x86_64" ] && \
      [ "$(/usr/sbin/sysctl -in hw.optional.arm64 2>/dev/null || true)" = "1" ]; then
      machine="arm64"
    fi
  fi

  case "$machine" in
    arm64) printf 'arm64\n' ;;
    *) printf 'x86_64\n' ;;
  esac
}

brew_prefix() {
  "$1" --prefix 2>/dev/null || true
}

brew_matches_hardware() {
  local candidate="$1"
  local prefix
  prefix="$(brew_prefix "$candidate")"
  [ -n "$prefix" ] || return 1

  if [ "$(homebrew_hardware_arch)" = "arm64" ]; then
    [ "$prefix" != "/usr/local" ]
  else
    [ "$prefix" != "/opt/homebrew" ]
  fi
}

warn_about_incompatible_brew() {
  local candidate
  local prefix

  candidate="$(command -v brew 2>/dev/null || true)"
  [ -n "$candidate" ] || return 0
  brew_matches_hardware "$candidate" && return 0
  prefix="$(brew_prefix "$candidate")"

  if [ "$(homebrew_hardware_arch)" = "arm64" ] && \
    [ "$prefix" = "/usr/local" ]; then
    warn "Ignoring Intel Homebrew at $candidate on Apple silicon; using native /opt/homebrew."
  else
    warn "Ignoring Homebrew at $candidate because it does not match this Mac's architecture."
  fi
}

ensure_brew() {
  local install_status
  local installer

  warn_about_incompatible_brew
  BREW_BIN="$(find_brew 2>/dev/null || true)"
  if [ -n "$BREW_BIN" ]; then
    export PATH="$(dirname "$BREW_BIN"):$PATH"
    return 0
  fi
  say "Installing Homebrew"
  if [ "$DRY_RUN" -eq 1 ]; then
    note "Would run the official Homebrew installer."
    BREW_BIN="brew"
    return 0
  fi
  installer="$TEMP_ROOT/homebrew-install.sh"
  if ! curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
    https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh --output "$installer"; then
    record_failure "Could not download the Homebrew installer"
    return 1
  fi
  if [ "$(homebrew_hardware_arch)" = "arm64" ]; then
    /usr/bin/arch -arm64 /bin/bash "$installer"
  else
    /bin/bash "$installer"
  fi
  install_status="$?"
  if [ "$install_status" -ne 0 ]; then
    record_failure "Homebrew installation failed"
    return 1
  fi
  BREW_BIN="$(find_brew 2>/dev/null || true)"
  if [ -z "$BREW_BIN" ]; then
    record_failure "Homebrew installed but brew is not discoverable"
    return 1
  fi
  export PATH="$(dirname "$BREW_BIN"):$PATH"
}

refresh_brew() {
  say "Refreshing Homebrew"
  if run "$BREW_BIN" update; then
    return 0
  fi
  warn "Homebrew update failed; continuing so already-current packages can still be checked."
  return 1
}

run_brew_cask_install() {
  local item="$1"
  local log="$TEMP_ROOT/homebrew-cask-install.log"
  local status

  if [ "$DRY_RUN" -eq 1 ]; then
    run "$BREW_BIN" install --cask "$item"
    return 0
  fi

  : > "$log"
  "$BREW_BIN" install --cask "$item" 2>&1 | tee "$log"
  status="${PIPESTATUS[0]}"
  return "$status"
}

install_brew_cask() {
  local item="$1"
  local log="$TEMP_ROOT/homebrew-cask-install.log"

  if run_brew_cask_install "$item"; then
    return 0
  fi
  if ! grep -Fq 'undefined method' "$log"; then
    return 1
  fi

  warn "Homebrew could not read the current $item cask; refreshing and retrying once."
  if "$BREW_BIN" update && run_brew_cask_install "$item"; then
    return 0
  fi
  warn "Homebrew still cannot read current cask metadata. Review local tap changes, then run '$BREW_BIN update-reset' before retrying WutPack."
  return 1
}

install_brew_manifest() {
  local manifest="$1"
  local kind="$2"
  local item
  local items=()

  # Read the complete manifest before launching package managers. Commands such
  # as `brew install node` may read standard input and would otherwise consume
  # the remaining manifest lines from the loop.
  while IFS= read -r item || [ -n "$item" ]; do
    case "$item" in ''|'#'*) continue ;; esac
    items+=("$item")
  done < "$manifest"

  for item in "${items[@]}"; do
    if [ "$kind" = "formula" ]; then
      if [ "$DRY_RUN" -eq 0 ] && "$BREW_BIN" list --formula "$item" >/dev/null 2>&1; then
        note "$item already installed"
      else
        run_checked "Homebrew formula failed: $item" "$BREW_BIN" install "$item" || true
      fi
    else
      if [ "$DRY_RUN" -eq 0 ] && "$BREW_BIN" list --cask "$item" >/dev/null 2>&1; then
        note "$item already installed"
      elif ! install_brew_cask "$item"; then
        record_failure "Homebrew cask failed: $item"
        if [ "$item" = "chromium" ]; then
          warn "Chromium failed; trying Google Chrome as a compatible browser fallback"
          if ! install_brew_cask google-chrome; then
            record_failure "Browser fallback failed: google-chrome"
          fi
        fi
      fi
    fi
  done
}

find_uv() {
  if command -v uv >/dev/null 2>&1; then command -v uv; return; fi
  for candidate in "$LOCAL_BIN/uv" /opt/homebrew/bin/uv /usr/local/bin/uv; do
    [ -x "$candidate" ] && { printf '%s\n' "$candidate"; return; }
  done
  return 1
}

install_requirements() {
  local python_bin="$1"
  local manifest="$2"
  local label="$3"
  if run "$UV_BIN" pip install --python "$python_bin" --upgrade --exact --strict \
    -r "$manifest"; then
    return 0
  fi
  record_failure "$label dependency resolution failed"
  return 1
}

install_full_knowledge_requirements() {
  local python_bin="$1"
  local core_manifest="$2"
  local ml_manifest="$3"

  # Resolve both layers together because they share transitive dependencies.
  # Installing the ML layer separately can upgrade packages beyond constraints
  # imposed by the core layer even though each manifest resolves on its own.
  if run "$UV_BIN" pip install --python "$python_bin" --upgrade --exact --strict \
    -r "$core_manifest" -r "$ml_manifest"; then
    return 0
  fi

  record_failure "Full knowledge Python dependency resolution failed"
  warn "Falling back to the core knowledge layer"
  install_requirements "$python_bin" "$core_manifest" "Core Python"
  return 1
}

ensure_python_env() {
  local env_dir="$1"
  if [ ! -x "$env_dir/bin/python" ]; then
    run_checked "Could not create Python environment: $env_dir" \
      "$UV_BIN" venv --python 3.12 --seed "$env_dir" || return 1
  fi
}

install_python_layers() {
  say "Building persistent Python environments"
  UV_BIN="$(find_uv 2>/dev/null || true)"
  if [ -z "$UV_BIN" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      UV_BIN="uv"
      note "Would use uv installed by Homebrew"
    else
      record_failure "uv is unavailable; Python environments were skipped"
      return
    fi
  fi
  export UV_CACHE_DIR="$CACHE_ROOT/uv"
  export PLAYWRIGHT_BROWSERS_PATH="$CACHE_ROOT/playwright"
  run_checked "Could not install managed Python 3.12" "$UV_BIN" python install 3.12 || true
  ensure_python_env "$KNOWLEDGE_ENV" || return
  if [ "$PROFILE" = "full" ]; then
    install_full_knowledge_requirements \
      "$KNOWLEDGE_ENV/bin/python" \
      "$PROJECT_ROOT/manifests/python-core.txt" \
      "$PROJECT_ROOT/manifests/python-ml.txt" || true
    ensure_python_env "$AGENT_ENV" || return
    install_requirements "$AGENT_ENV/bin/python" "$PROJECT_ROOT/manifests/python-agents.txt" "Agent Python"
  else
    install_requirements "$KNOWLEDGE_ENV/bin/python" "$PROJECT_ROOT/manifests/python-core.txt" "Core Python"
  fi
  run_checked "Knowledge Python dependency check failed" \
    "$UV_BIN" pip check --python "$KNOWLEDGE_ENV/bin/python" || true
  if [ "$PROFILE" = "full" ] && [ -x "$AGENT_ENV/bin/python" ]; then
    run_checked "Agent Python dependency check failed" \
      "$UV_BIN" pip check --python "$AGENT_ENV/bin/python" || true
  fi
  if [ -x "$KNOWLEDGE_ENV/bin/playwright" ]; then
    run_checked "Playwright Chromium installation failed" "$KNOWLEDGE_ENV/bin/playwright" install chromium || true
  fi
}

install_node_manifest() {
  local npm_bin="$1"
  local manifest="$2"
  local package
  local packages=()
  while IFS= read -r package || [ -n "$package" ]; do
    case "$package" in ''|'#'*) continue ;; esac
    packages+=("$package")
  done < "$manifest"
  for package in "${packages[@]}"; do
    run_checked "Node package failed: $package" "$npm_bin" install --global \
      --prefix "$NODE_PREFIX" --cache "$CACHE_ROOT/npm" "$package" || true
  done
}

uninstall_node_manifest() {
  local npm_bin="$1"
  local manifest="$2"
  local package
  local packages=()
  while IFS= read -r package || [ -n "$package" ]; do
    case "$package" in ''|'#'*) continue ;; esac
    packages+=("$package")
  done < "$manifest"
  for package in "${packages[@]}"; do
    if [ "$DRY_RUN" -eq 0 ] && ! "$npm_bin" list --global --prefix "$NODE_PREFIX" \
      --depth=0 "$package" >/dev/null 2>&1; then
      continue
    fi
    run_checked "Could not remove retired Node package: $package" \
      "$npm_bin" uninstall --global --prefix "$NODE_PREFIX" \
      --cache "$CACHE_ROOT/npm" "$package" || true
  done
}

install_node_layers() {
  say "Installing persistent Node tools"
  local npm_bin
  npm_bin="$(command -v npm 2>/dev/null || true)"
  if [ -z "$npm_bin" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      npm_bin="npm"
      note "Would use npm installed with Node by Homebrew"
    else
      record_failure "npm is unavailable; Node tools were skipped"
      return
    fi
  fi
  export PUPPETEER_CACHE_DIR="$CACHE_ROOT/puppeteer"
  run mkdir -p "$NODE_PREFIX" "$CACHE_ROOT/npm"
  uninstall_node_manifest "$npm_bin" "$PROJECT_ROOT/manifests/node-retired.txt"
  install_node_manifest "$npm_bin" "$PROJECT_ROOT/manifests/node-tools.txt"
  if [ "$SKIP_AI_CLIS" -eq 0 ]; then
    install_node_manifest "$npm_bin" "$PROJECT_ROOT/manifests/node-agents.txt"
  fi
  export PATH="$NODE_PREFIX/bin:$PATH"
}

is_wutpack_skill_tree() {
  local target="$1"
  local skill_name="$2"
  local source="$PROJECT_ROOT/skills/$skill_name"

  if [ -f "$target/.wutpack-skill" ] && \
    grep -Fxq "WutPack managed skill v1: $skill_name" \
      "$target/.wutpack-skill"; then
    return 0
  fi

  [ -f "$target/SKILL.md" ] && [ -f "$target/agents/openai.yaml" ] || \
    return 1

  if cmp -s "$target/SKILL.md" "$source/SKILL.md" && \
    cmp -s "$target/agents/openai.yaml" "$source/agents/openai.yaml"; then
    return 0
  fi

  if grep -Eq "^name:[[:space:]]*${skill_name}[[:space:]]*$" \
      "$target/SKILL.md" && \
    grep -Fq 'display_name: "[wutlabs] ' "$target/agents/openai.yaml" && \
    grep -Fq "\$$skill_name" "$target/agents/openai.yaml"; then
    return 0
  fi

  cmp -s "$target/SKILL.md" "$source/SKILL.md" && \
    sed 's/^  display_name: "/  display_name: "[wutlabs] /' \
      "$target/agents/openai.yaml" | \
      cmp -s - "$source/agents/openai.yaml"
}

sync_skill_dir() (
  local target_parent="$1"
  local skill_name="$2"
  local target="$target_parent/$skill_name"
  local stage_root=""
  local backup_root=""
  local had_previous=0
  local swap_active=0
  local keep_backup=0

  cleanup_skill_sync() {
    local status=$?
    trap - EXIT

    if [ "$swap_active" -eq 1 ] && [ "$had_previous" -eq 1 ] && \
      [ -e "$backup_root/previous" ]; then
      if [ -e "$target" ] || [ -L "$target" ]; then
        if ! mv "$target" "$backup_root/failed"; then
          printf '\033[1;31mERROR:\033[0m Could not roll back skill %s. Backup preserved at %s\n' \
            "$skill_name" "$backup_root" >&2
          keep_backup=1
        fi
      fi
      if [ "$keep_backup" -eq 0 ] && \
        ! mv "$backup_root/previous" "$target"; then
        printf '\033[1;31mERROR:\033[0m Could not restore skill %s. Backup preserved at %s\n' \
          "$skill_name" "$backup_root" >&2
        keep_backup=1
      fi
    fi

    case "$stage_root" in
      "$target_parent"/.wutpack-"$skill_name"-stage.*) rm -rf -- "$stage_root" ;;
    esac
    if [ "$keep_backup" -eq 0 ]; then
      case "$backup_root" in
        "$target_parent"/.wutpack-"$skill_name"-backup.*) rm -rf -- "$backup_root" ;;
      esac
    fi
    exit "$status"
  }
  trap cleanup_skill_sync EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  stage_root="$(mktemp -d "$target_parent/.wutpack-$skill_name-stage.XXXXXX")" || \
    fatal "Could not stage skill: $skill_name"
  ditto "$PROJECT_ROOT/skills/$skill_name" "$stage_root" || \
    fatal "Could not stage skill: $skill_name"
  printf '%s\n' "WutPack managed skill v1: $skill_name" > \
    "$stage_root/.wutpack-skill" || fatal "Could not mark skill: $skill_name"

  if [ -e "$target" ] || [ -L "$target" ]; then
    [ -d "$target" ] && [ ! -L "$target" ] || \
      fatal "Cannot replace non-directory skill target: $target"
    is_wutpack_skill_tree "$target" "$skill_name" || \
      fatal "Refusing to replace a skill not owned by WutPack: $target"
    had_previous=1
  fi

  backup_root="$(mktemp -d "$target_parent/.wutpack-$skill_name-backup.XXXXXX")" || \
    fatal "Could not create skill backup: $skill_name"
  swap_active=1
  if [ "$had_previous" -eq 1 ]; then
    mv "$target" "$backup_root/previous" || \
      fatal "Could not back up skill: $skill_name"
  fi
  mv "$stage_root" "$target" || fatal "Could not activate skill: $skill_name"
  stage_root=""
  swap_active=0

  rm -rf -- "$backup_root" || fatal "Could not remove skill backup: $skill_name"
  backup_root=""
  trap - EXIT INT TERM
)

install_skill_tree() {
  local target="$1"
  local skill_name
  run_required "Could not create skill directory: $target" mkdir -p "$target"
  for skill_name in "${EXPECTED_SKILLS[@]}"; do
    if [ "$DRY_RUN" -eq 1 ]; then
      note "Would install $skill_name -> $target"
    else
      [ -f "$PROJECT_ROOT/skills/$skill_name/SKILL.md" ] || \
        fatal "Required skill disappeared during setup: $skill_name"
      sync_skill_dir "$target" "$skill_name" || \
        fatal "Could not install $skill_name into $target"
    fi
  done
}

install_skills() {
  say "Installing scenario specialists"
  local install_codex=0
  local install_claude=0
  case "$HOST" in
    codex) install_codex=1 ;;
    claude) install_claude=1 ;;
    both) install_codex=1; install_claude=1 ;;
    auto)
      { command -v codex >/dev/null 2>&1 || [ -d "$USER_HOME/.codex" ]; } && install_codex=1
      { command -v claude >/dev/null 2>&1 || [ -d "$USER_HOME/.claude" ]; } && install_claude=1
      if [ "$install_codex" -eq 0 ] && [ "$install_claude" -eq 0 ]; then
        install_codex=1
        install_claude=1
      fi
      ;;
  esac
  [ "$install_codex" -eq 1 ] && install_skill_tree "$USER_HOME/.codex/skills"
  [ "$install_claude" -eq 1 ] && install_skill_tree "$USER_HOME/.claude/skills"
}

link_command() {
  local source="$1"
  local name="$2"
  local required="${3:-0}"
  local target="$LOCAL_BIN/$name"
  if [ ! -e "$source" ]; then
    [ "$required" -eq 0 ] && return 0
    fatal "Required command source is missing: $source"
  fi
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    if [ "$required" -eq 1 ]; then
      fatal "Cannot install $name because a non-symlink already exists: $target"
    fi
    warn "Leaving existing command untouched: $target"
    return 0
  fi
  run_required "Could not link command: $target" ln -sfn "$source" "$target"
}

install_shims() {
  say "Linking stable commands"
  run_required "Could not create command directory: $LOCAL_BIN" mkdir -p "$LOCAL_BIN"
  link_command "$PROJECT_ROOT/bin/wut" wut 1
  link_command "$KNOWLEDGE_ENV/bin/python" knowledge-python
  link_command "$AGENT_ENV/bin/python" agent-python
  local name
  for name in jupyter jupyter-lab ipython cairosvg mkdocs pdoc sphinx-build papermill; do
    link_command "$KNOWLEDGE_ENV/bin/$name" "$name"
  done
  for name in crewai agno browser-use fastmcp litellm; do
    link_command "$AGENT_ENV/bin/$name" "$name"
  done
}

resolve_profile_file() {
  local source="$1"
  local directory
  local target

  while [ -L "$source" ]; do
    directory="$(CDPATH= cd -- "$(dirname -- "$source")" && pwd -P)" || return 1
    target="$(readlink "$source")" || return 1
    case "$target" in
      /*) source="$target" ;;
      *) source="$directory/$target" ;;
    esac
  done

  directory="$(CDPATH= cd -- "$(dirname -- "$source")" && pwd -P)" || return 1
  printf '%s/%s\n' "$directory" "$(basename -- "$source")"
}

ensure_profile_block() {
  local profile_file="$1"
  local marker_start='# >>> WutPack persistent tools >>>'
  local marker_end='# <<< WutPack persistent tools <<<'
  local profile_dir
  local profile_name
  local profile_mode
  local profile_temp
  local line
  local in_block=0

  touch "$profile_file" || fatal "Could not create shell profile: $profile_file"
  profile_file="$(resolve_profile_file "$profile_file")" || \
    fatal "Could not resolve shell profile: $profile_file"
  [ -f "$profile_file" ] || fatal "Could not update shell profile: $profile_file"
  profile_dir="$(CDPATH= cd -- "$(dirname -- "$profile_file")" && pwd -P)" || \
    fatal "Could not resolve shell profile directory: $profile_file"
  profile_name="$(basename -- "$profile_file")"
  profile_mode="$(stat -f '%Lp' "$profile_file")" || \
    fatal "Could not inspect shell profile: $profile_file"
  profile_temp="$(mktemp "$profile_dir/.$profile_name.wutpack.XXXXXX")" || \
    fatal "Could not stage shell profile update: $profile_file"

  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$line" = "$marker_start" ]; then
      in_block=1
      continue
    fi
    if [ "$line" = "$marker_end" ]; then
      in_block=0
      continue
    fi
    if [ "$in_block" -eq 1 ]; then
      case "$line" in
        ''|\
        'export WUTPACK_HOME="$HOME/Library/Application Support/WutPack"'|\
        'export UV_CACHE_DIR="$HOME/Library/Caches/WutPack/uv"'|\
        'export PLAYWRIGHT_BROWSERS_PATH="$HOME/Library/Caches/WutPack/playwright"'|\
        'export PUPPETEER_CACHE_DIR="$HOME/Library/Caches/WutPack/puppeteer"'|\
        'case ":${NODE_PATH:-}:" in *":$WUTPACK_HOME/npm-global/lib/node_modules:"*) ;; *) export NODE_PATH="$WUTPACK_HOME/npm-global/lib/node_modules${NODE_PATH:+:$NODE_PATH}" ;; esac'|\
        'case ":$PATH:" in *":$WUTPACK_HOME/npm-global/bin:"*) ;; *) export PATH="$WUTPACK_HOME/npm-global/bin:$PATH" ;; esac'|\
        'case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac')
          continue
          ;;
        *) in_block=0 ;;
      esac
    fi
    printf '%s\n' "$line" >> "$profile_temp" || {
      rm -f -- "$profile_temp"
      fatal "Could not stage shell profile update: $profile_file"
    }
  done < "$profile_file" || {
    rm -f -- "$profile_temp"
    fatal "Could not read shell profile: $profile_file"
  }

  {
    printf '%s\n' "$marker_start"
    printf '%s\n' 'export WUTPACK_HOME="$HOME/Library/Application Support/WutPack"'
    printf '%s\n' 'export UV_CACHE_DIR="$HOME/Library/Caches/WutPack/uv"'
    printf '%s\n' 'export PLAYWRIGHT_BROWSERS_PATH="$HOME/Library/Caches/WutPack/playwright"'
    printf '%s\n' 'export PUPPETEER_CACHE_DIR="$HOME/Library/Caches/WutPack/puppeteer"'
    printf '%s\n' 'case ":${NODE_PATH:-}:" in *":$WUTPACK_HOME/npm-global/lib/node_modules:"*) ;; *) export NODE_PATH="$WUTPACK_HOME/npm-global/lib/node_modules${NODE_PATH:+:$NODE_PATH}" ;; esac'
    printf '%s\n' 'case ":$PATH:" in *":$WUTPACK_HOME/npm-global/bin:"*) ;; *) export PATH="$WUTPACK_HOME/npm-global/bin:$PATH" ;; esac'
    printf '%s\n' 'case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac'
    printf '%s\n' "$marker_end"
  } >> "$profile_temp" || {
    rm -f -- "$profile_temp"
    fatal "Could not stage shell profile update: $profile_file"
  }
  chmod "$profile_mode" "$profile_temp" || {
    rm -f -- "$profile_temp"
    fatal "Could not preserve shell profile permissions: $profile_file"
  }
  mv -f "$profile_temp" "$profile_file" || {
    rm -f -- "$profile_temp"
    fatal "Could not update shell profile: $profile_file"
  }
}

install_shell_profile() {
  say "Making the tools visible in future terminals"
  if [ "$DRY_RUN" -eq 1 ]; then
    note "Would update $USER_HOME/.zprofile and $USER_HOME/.zshrc"
    return
  fi
  ensure_profile_block "$USER_HOME/.zprofile"
  ensure_profile_block "$USER_HOME/.zshrc"
}

validate_source_tree
preflight_command_target
acquire_setup_lock

run_required "Could not create WutPack state directories" \
  mkdir -p "$STATE_ROOT" "$CACHE_ROOT" "$LOCAL_BIN"

if [ "$SKILLS_ONLY" -eq 0 ]; then
  if ensure_brew; then
    refresh_brew || true
    say "Installing command-line workbench"
    install_brew_manifest "$PROJECT_ROOT/manifests/brew-formulae.txt" formula
    if [ "$SKIP_CASKS" -eq 0 ]; then
      say "Installing desktop workbench"
      install_brew_manifest "$PROJECT_ROOT/manifests/brew-casks.txt" cask
      if [ "$WITH_EXTRAS" -eq 1 ]; then
        install_brew_manifest "$PROJECT_ROOT/manifests/brew-extras.txt" cask
      fi
    fi
  fi
  install_python_layers
  install_node_layers
fi

install_skills
install_shims
install_shell_profile

setup_status=0
if [ "${#FAILURES[@]}" -gt 0 ]; then
  say "WutPack setup incomplete"
  printf '\nCompleted with %s optional failure(s):\n' "${#FAILURES[@]}" >&2
  for failure in "${FAILURES[@]}"; do printf '  - %s\n' "$failure" >&2; done
  setup_status=2
else
  say "WutPack setup complete"
fi

note "Persistent state: $STATE_ROOT"
note "Skills installed for: $HOST"
note "Agent sign-in and API keys are intentionally left to you."

printf '\nIMPORTANT: Open a new terminal before using WutPack, then run: wut doctor\n'
printf 'Author: WUTLABS SUNNYVALE CA\n'
exit "$setup_status"
