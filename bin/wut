#!/usr/bin/env bash

set -uo pipefail

resolve_self_dir() {
  local source="$1"
  local directory

  case "$source" in
    */*) ;;
    *) source="$(command -v "$source" 2>/dev/null || printf '%s\n' "$source")" ;;
  esac

  while [ -L "$source" ]; do
    directory="$(CDPATH= cd -- "$(dirname -- "$source")" && pwd -P)" || return 1
    source="$(readlink "$source")" || return 1
    case "$source" in
      /*) ;;
      *) source="$directory/$source" ;;
    esac
  done

  CDPATH= cd -- "$(dirname -- "$source")" && pwd -P
}

SELF_DIR="$(resolve_self_dir "$0")" || {
  printf 'Could not resolve the WutPack command location: %s\n' "$0" >&2
  exit 1
}
PROJECT_ROOT="${WUTPACK_INSTALL_ROOT:-$(CDPATH= cd -- "$SELF_DIR/.." && pwd -P)}"
USER_HOME="${WUTPACK_TEST_ROOT:-$HOME}"
STATE_ROOT="${WUTPACK_STATE_ROOT:-$USER_HOME/Library/Application Support/WutPack}"
CACHE_ROOT="${WUTPACK_CACHE_ROOT:-$USER_HOME/Library/Caches/WutPack}"
KNOWLEDGE_ENV="$STATE_ROOT/knowledge"
AGENT_ENV="$STATE_ROOT/agents"
NODE_PREFIX="$STATE_ROOT/npm-global"
EXPECTED_SKILLS=(
  code-build
  data-lab
  debug-lab
  document-studio
  pdf-forensics
  publish-docs
  research-brief
  review-gate
  security-engineer
  ship-check
  spreadsheet-lab
  system-diagram
  technical-deck
)
EXPECTED_SKILL_COUNT="${#EXPECTED_SKILLS[@]}"
EXPECTED_PROFESSION_PACKS=(
  psychiatry
  surgery
  dermatology
  pediatric-surgery
  prosthodontics
  anesthesiology
  emergency-medicine
  radiology
  ophthalmology
  pathology
)
EXPECTED_FINANCE_PACKS=(
  finance-management
  finance-advisory
  finance-risk
  finance-investment-analysis
  finance-examination
  finance-credit
  finance-budget
  finance-accounting
  finance-underwriting
  finance-lending
)
EXPECTED_ENGINEERING_PACKS=(
  engineering-hardware
  engineering-petroleum
  engineering-aerospace
  engineering-nuclear
  engineering-chemical
  engineering-electrical
  engineering-safety
  engineering-materials
  engineering-biomedical
  engineering-marine
)
EXPECTED_TOOLPACK_COUNT=$((${#EXPECTED_PROFESSION_PACKS[@]} + ${#EXPECTED_FINANCE_PACKS[@]} + ${#EXPECTED_ENGINEERING_PACKS[@]}))

export PATH="$NODE_PREFIX/bin:$PATH"
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$CACHE_ROOT/playwright}"
export PUPPETEER_CACHE_DIR="${PUPPETEER_CACHE_DIR:-$CACHE_ROOT/puppeteer}"
if [ -n "${NODE_PATH:-}" ]; then
  export NODE_PATH="$NODE_PREFIX/lib/node_modules:$NODE_PATH"
else
  export NODE_PATH="$NODE_PREFIX/lib/node_modules"
fi

usage() {
  cat <<'EOF'
WutPack control command

Usage: wut <command> [arguments]

  doctor [--headless] Check the persistent workbench and installed hosts
  paths              Show every persistent location
  skills             List scenario specialists
  routes             Show which specialist fits which job
  packs [CATEGORY]   List all 30 toolpacks or one category
  pack NAME [ACTION] Show a pack, its tools, its prompt, or launch Codex
  setup [options]    Re-run setup from the installed source
  update [options]   Fetch the latest source and re-run setup
  python [args]      Run the knowledge-work Python
  agent-python       Run the agent-framework Python
  lab [args]         Start JupyterLab
  deck [output]      Generate an editable technical PPTX example
  security-lab [out] Build the interactive security engineering HTML lab
  diagram IN OUT     Render Mermaid source to SVG/PNG/PDF
  render FILE [DIR]  Convert an Office document to PDF with LibreOffice
  ocr IN OUT         OCR a scanned PDF
  version            Print the installed version
  help               Show this help
EOF
}

find_soffice() {
  if command -v soffice >/dev/null 2>&1; then command -v soffice; return; fi
  local app="/Applications/LibreOffice.app/Contents/MacOS/soffice"
  [ -x "$app" ] && { printf '%s\n' "$app"; return; }
  return 1
}

count_packaged_skills() {
  local count=0
  local skill_name
  for skill_name in "${EXPECTED_SKILLS[@]}"; do
    [ -f "$PROJECT_ROOT/skills/$skill_name/SKILL.md" ] || continue
    count=$((count + 1))
  done
  printf '%s\n' "$count"
}

count_installed_skills() {
  local target="$1"
  local count=0
  local skill_name
  for skill_name in "${EXPECTED_SKILLS[@]}"; do
    [ -f "$target/$skill_name/SKILL.md" ] || continue
    count=$((count + 1))
  done
  printf '%s\n' "$count"
}

has_managed_pptxgenjs() {
  local module_root="$NODE_PREFIX/lib/node_modules/pptxgenjs"
  [ -d "$module_root" ] || return 1
  (
    CDPATH= cd -- "$NODE_PREFIX/lib/node_modules" || exit 1
    NODE_PATH="$NODE_PREFIX/lib/node_modules" \
      node -e 'require(process.argv[1])' "$module_root"
  ) >/dev/null 2>&1
}

doctor() {
  local headless=0
  local missing=0
  local command_name
  local packaged_skills
  local packaged_toolpacks
  local codex_skills
  local claude_skills
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --headless) headless=1; shift ;;
      -h|--help)
        printf 'Usage: wut doctor [--headless]\n'
        return 0
        ;;
      *) printf 'Unknown doctor option: %s\nUsage: wut doctor [--headless]\n' "$1" >&2; return 2 ;;
    esac
  done
  printf 'WutPack doctor\n\n'
  for command_name in git rg jq uv node npm pandoc pdfinfo pdftotext qpdf mutool ocrmypdf tesseract magick dot duckdb; do
    if command -v "$command_name" >/dev/null 2>&1; then
      printf '  [ok]   %-16s %s\n' "$command_name" "$(command -v "$command_name")"
    else
      printf '  [miss] %-16s\n' "$command_name"
      missing=$((missing + 1))
    fi
  done
  if find_soffice >/dev/null 2>&1; then
    printf '  [ok]   %-16s %s\n' soffice "$(find_soffice)"
  elif [ "$headless" -eq 1 ]; then
    printf '  [skip] %-16s desktop applications omitted for headless verification\n' soffice
  else
    printf '  [miss] %-16s\n' soffice
    missing=$((missing + 1))
  fi
  if [ -x "$NODE_PREFIX/bin/mmdc" ]; then
    printf '  [ok]   %-16s %s\n' mmdc "$NODE_PREFIX/bin/mmdc"
  else
    printf '  [miss] %-16s %s\n' mmdc "$NODE_PREFIX/bin/mmdc"
    missing=$((missing + 1))
  fi
  if [ -f "$PROJECT_ROOT/VERSION" ]; then
    printf '  [ok]   WutPack source   %s\n' "$PROJECT_ROOT"
  else
    printf '  [miss] WutPack source   %s\n' "$PROJECT_ROOT"
    missing=$((missing + 1))
  fi
  if [ -x "$PROJECT_ROOT/setup" ]; then
    printf '  [ok]   setup command\n'
  else
    printf '  [miss] setup command    %s/setup\n' "$PROJECT_ROOT"
    missing=$((missing + 1))
  fi
  packaged_toolpacks="$(count_toolpacks)"
  if [ "$packaged_toolpacks" -eq "$EXPECTED_TOOLPACK_COUNT" ]; then
    printf '  [ok]   toolpacks        %s/%s\n' "$packaged_toolpacks" "$EXPECTED_TOOLPACK_COUNT"
  else
    printf '  [miss] toolpacks        %s/%s\n' "$packaged_toolpacks" "$EXPECTED_TOOLPACK_COUNT"
    missing=$((missing + 1))
  fi
  if [ -f "$PROJECT_ROOT/skills/technical-deck/scripts/new_technical_deck.mjs" ]; then
    printf '  [ok]   deck generator\n'
  else
    printf '  [miss] deck generator\n'
    missing=$((missing + 1))
  fi
  if has_managed_pptxgenjs; then
    printf '  [ok]   %-16s %s\n' pptxgenjs "$NODE_PREFIX/lib/node_modules/pptxgenjs"
  else
    printf '  [miss] %-16s %s\n' pptxgenjs "$NODE_PREFIX/lib/node_modules/pptxgenjs"
    missing=$((missing + 1))
  fi
  if [ -x "$KNOWLEDGE_ENV/bin/python" ]; then
    printf '  [ok]   knowledge env\n'
  else
    printf '  [miss] knowledge env\n'
    missing=$((missing + 1))
  fi
  if [ -x "$KNOWLEDGE_ENV/bin/jupyter-lab" ]; then
    printf '  [ok]   JupyterLab\n'
  else
    printf '  [miss] JupyterLab\n'
    missing=$((missing + 1))
  fi
  [ -x "$AGENT_ENV/bin/python" ] && printf '  [ok]   agent env\n' || printf '  [note] agent env not installed (core profile is valid)\n'
  packaged_skills="$(count_packaged_skills)"
  if [ "$packaged_skills" -ne "$EXPECTED_SKILL_COUNT" ]; then
    printf '  [miss] packaged skills  %s/%s\n' "$packaged_skills" "$EXPECTED_SKILL_COUNT"
    missing=$((missing + 1))
  else
    codex_skills="$(count_installed_skills "$USER_HOME/.codex/skills")"
    claude_skills="$(count_installed_skills "$USER_HOME/.claude/skills")"
    if [ "$codex_skills" -gt 0 ]; then
      if [ "$codex_skills" -eq "$EXPECTED_SKILL_COUNT" ]; then
        printf '  [ok]   Codex skills     %s/%s\n' "$codex_skills" "$EXPECTED_SKILL_COUNT"
      else
        printf '  [miss] Codex skills     %s/%s\n' "$codex_skills" "$EXPECTED_SKILL_COUNT"
        missing=$((missing + 1))
      fi
    fi
    if [ "$claude_skills" -gt 0 ]; then
      if [ "$claude_skills" -eq "$EXPECTED_SKILL_COUNT" ]; then
        printf '  [ok]   Claude skills    %s/%s\n' "$claude_skills" "$EXPECTED_SKILL_COUNT"
      else
        printf '  [miss] Claude skills    %s/%s\n' "$claude_skills" "$EXPECTED_SKILL_COUNT"
        missing=$((missing + 1))
      fi
    fi
    if [ "$codex_skills" -eq 0 ] && [ "$claude_skills" -eq 0 ]; then
      printf '  [miss] host skills      none of %s required skills installed\n' "$EXPECTED_SKILL_COUNT"
      missing=$((missing + 1))
    fi
  fi
  printf '\nMissing required checks: %s\n' "$missing"
  [ "$missing" -eq 0 ]
}

list_skills() {
  [ "$(count_packaged_skills)" -eq "$EXPECTED_SKILL_COUNT" ] || {
    printf 'WutPack skills are unavailable under %s\n' "$PROJECT_ROOT" >&2
    return 1
  }
  local skill_name
  local skill_file
  for skill_name in "${EXPECTED_SKILLS[@]}"; do
    skill_file="$PROJECT_ROOT/skills/$skill_name/SKILL.md"
    local name description
    name="$(awk '/^name:/{sub(/^name:[[:space:]]*/,""); print; exit}' "$skill_file")"
    description="$(awk '/^description:/{sub(/^description:[[:space:]]*/,""); print; exit}' "$skill_file")"
    printf '  %-20s %s\n' "$name" "$description"
  done
}

count_toolpacks() {
  local count=0
  local pack_name
  for pack_name in "${EXPECTED_PROFESSION_PACKS[@]}"; do
    [ -f "$PROJECT_ROOT/packs/professions/$pack_name.md" ] || continue
    count=$((count + 1))
  done
  for pack_name in "${EXPECTED_FINANCE_PACKS[@]}"; do
    [ -f "$PROJECT_ROOT/packs/finance/$pack_name.md" ] || continue
    count=$((count + 1))
  done
  for pack_name in "${EXPECTED_ENGINEERING_PACKS[@]}"; do
    [ -f "$PROJECT_ROOT/packs/engineering/$pack_name.md" ] || continue
    count=$((count + 1))
  done
  printf '%s\n' "$count"
}

toolpack_field() {
  local field="$1"
  local pack_file="$2"
  awk -v field="$field" '
    $0 == "---" { markers += 1; next }
    markers == 2 { exit }
    markers == 1 && index($0, field ":") == 1 {
      sub(/^[^:]+:[[:space:]]*/, "")
      print
      exit
    }
  ' "$pack_file"
}

toolpack_path() {
  local pack_name="$1"
  local pack_file
  local pack_category
  case "$pack_name" in
    ''|*[!a-z0-9-]*) return 1 ;;
  esac
  for pack_category in professions finance engineering; do
    pack_file="$PROJECT_ROOT/packs/$pack_category/$pack_name.md"
    if [ -f "$pack_file" ]; then
      printf '%s\n' "$pack_file"
      return 0
    fi
  done
  return 1
}

list_toolpack_group() {
  local title="$1"
  local basis="$2"
  local pack_directory="$3"
  shift 3
  local pack_name
  local pack_file
  local rank
  local profession
  local description
  printf '%s\n' "$title"
  printf 'Basis: %s\n\n' "$basis"
  for pack_name in "$@"; do
    pack_file="$PROJECT_ROOT/packs/$pack_directory/$pack_name.md"
    rank="$(toolpack_field rank "$pack_file")"
    profession="$(toolpack_field profession "$pack_file")"
    description="$(toolpack_field description "$pack_file")"
    printf '  %02d  %-29s %-42s %s\n' "$rank" "$pack_name" "$profession" "$description"
  done
}

list_toolpacks() {
  [ "$#" -le 1 ] || {
    printf 'Usage: wut packs [all|profession|finance|engineering]\n' >&2
    return 2
  }
  local category="${1:-all}"
  case "$category" in
    all|profession|finance|engineering) ;;
    *)
      printf 'Unknown toolpack category: %s\nUsage: wut packs [all|profession|finance|engineering]\n' \
        "$category" >&2
      return 2
      ;;
  esac
  [ "$(count_toolpacks)" -eq "$EXPECTED_TOOLPACK_COUNT" ] || {
    printf 'WutPack toolpacks are incomplete under %s\n' "$PROJECT_ROOT" >&2
    return 1
  }

  printf 'WutPack career toolpacks (%s total)\n\n' "$EXPECTED_TOOLPACK_COUNT"
  if [ "$category" = "all" ] || [ "$category" = "profession" ]; then
    list_toolpack_group \
      'High-pay profession toolpacks' \
      'first ten entries in the U.S. BLS 2024 highest-pay table; all are tied in its top-coded bracket.' \
      professions "${EXPECTED_PROFESSION_PACKS[@]}"
  fi
  if [ "$category" = "all" ] || [ "$category" = "finance" ]; then
    [ "$category" = "all" ] && printf '\n'
    list_toolpack_group \
      'Finance toolpacks' \
      'finance-focused roles ordered by U.S. BLS May 2025 annual mean wage.' \
      finance "${EXPECTED_FINANCE_PACKS[@]}"
  fi
  if [ "$category" = "all" ] || [ "$category" = "engineering" ]; then
    [ "$category" = "all" ] && printf '\n'
    list_toolpack_group \
      'Engineering toolpacks' \
      'ten highest-paid detailed roles in the U.S. BLS 2024 architecture and engineering table.' \
      engineering "${EXPECTED_ENGINEERING_PACKS[@]}"
  fi
  printf '\nUse: wut pack NAME [show|tools|prompt|codex] [request]\n'
}

toolpack_prompt() {
  local pack_file="$1"
  awk '
    $0 == "## Starter prompt" { in_prompt = 1; next }
    in_prompt && /^## / { exit }
    in_prompt { print }
  ' "$pack_file" | awk '
    BEGIN { pending = "" }
    /^[[:space:]]*$/ && output == 0 { next }
    {
      if (pending != "") print pending
      print
      output = 1
      pending = ""
    }
  '
}

toolpack_command() {
  if [ "$#" -eq 0 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    printf 'Usage: wut pack NAME [show|tools|prompt|codex] [request]\n'
    printf '  show    Print the complete pack (default)\n'
    printf '  tools   Print its specialists and deterministic tools\n'
    printf '  prompt  Print a copy-ready prompt; optional request text is appended\n'
    printf '  codex   Launch interactive Codex with that prompt and request\n'
    return 0
  fi

  local pack_name="$1"
  shift
  local pack_file
  pack_file="$(toolpack_path "$pack_name")" || {
    printf 'Unknown toolpack: %s\nRun: wut packs\n' "$pack_name" >&2
    return 2
  }

  local action="${1:-show}"
  [ "$#" -gt 0 ] && shift
  local request="$*"
  local prompt
  local codex_bin
  case "$action" in
    show)
      [ "$#" -eq 0 ] || {
        printf 'Usage: wut pack %s show\n' "$pack_name" >&2
        return 2
      }
      cat "$pack_file"
      ;;
    tools)
      [ "$#" -eq 0 ] || {
        printf 'Usage: wut pack %s tools\n' "$pack_name" >&2
        return 2
      }
      printf 'Category: %s\n' "$(toolpack_field category "$pack_file")"
      printf 'Profession: %s\n' "$(toolpack_field profession "$pack_file")"
      printf 'Pay basis: %s\n' "$(toolpack_field pay "$pack_file")"
      printf 'Specialists: %s\n' "$(toolpack_field specialists "$pack_file")"
      printf 'Tools: %s\n' "$(toolpack_field tools "$pack_file")"
      ;;
    prompt|codex)
      prompt="$(toolpack_prompt "$pack_file")"
      [ -n "$prompt" ] || {
        printf 'Toolpack has no starter prompt: %s\n' "$pack_name" >&2
        return 1
      }
      prompt="WutPack toolpack: $pack_name
Profession: $(toolpack_field profession "$pack_file")
Use these WutPack specialists when relevant: $(toolpack_field specialists "$pack_file")
Use these deterministic tools when they fit: $(toolpack_field tools "$pack_file")

$prompt"
      if [ -n "$request" ]; then
        prompt="$prompt

User request: $request"
      fi
      if [ "$action" = "prompt" ]; then
        printf '%s\n' "$prompt"
        return 0
      fi
      codex_bin="$(command -v codex 2>/dev/null || true)"
      [ -n "$codex_bin" ] || {
        printf 'Codex CLI is not installed. Run: wut setup\n' >&2
        return 1
      }
      exec "$codex_bin" "$prompt"
      ;;
    *)
      printf 'Unknown pack action: %s\nUsage: wut pack %s [show|tools|prompt|codex] [request]\n' \
        "$action" "$pack_name" >&2
      return 2
      ;;
  esac
}

routes() {
  cat <<'EOF'
Scenario                  Specialist
------------------------  ----------------
Evidence-backed research  research-brief
Excel models and charts   spreadsheet-lab
Scanned or broken PDFs    pdf-forensics
Editable PowerPoint       technical-deck
Data exploration          data-lab
HTML/PDF documentation    publish-docs
Architecture diagrams     system-diagram
Security systems + crypto  security-engineer
Professional Word docs    document-studio
Implement a change        code-build
Diagnose a failure        debug-lab
Review a diff             review-gate
Release readiness         ship-check
EOF
}

command_name="${1:-help}"
[ "$#" -gt 0 ] && shift

case "$command_name" in
  help|-h|--help) usage ;;
  version)
    [ -f "$PROJECT_ROOT/VERSION" ] || { printf 'WutPack source is incomplete: %s\n' "$PROJECT_ROOT" >&2; exit 1; }
    cat "$PROJECT_ROOT/VERSION"
    ;;
  doctor) doctor "$@" ;;
  paths)
    printf 'source=%s\nstate=%s\ncache=%s\nknowledge_python=%s\nagent_python=%s\nnode_prefix=%s\n' \
      "$PROJECT_ROOT" "$STATE_ROOT" "$CACHE_ROOT" "$KNOWLEDGE_ENV/bin/python" \
      "$AGENT_ENV/bin/python" "$NODE_PREFIX"
    ;;
  skills) list_skills ;;
  routes) routes ;;
  packs) list_toolpacks "$@" ;;
  pack) toolpack_command "$@" ;;
  setup)
    [ -x "$PROJECT_ROOT/setup" ] || { printf 'WutPack setup is unavailable under %s\n' "$PROJECT_ROOT" >&2; exit 1; }
    exec "$PROJECT_ROOT/setup" "$@"
    ;;
  update)
    installer="$(mktemp "${TMPDIR:-/tmp}/wutpack-update.XXXXXX")"
    trap 'rm -f -- "$installer"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    if ! curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
      https://raw.githubusercontent.com/sfungwinbond/Gstackwut/main/install.sh \
      --output "$installer"; then
      printf 'Could not download the WutPack installer.\n' >&2
      exit 1
    fi
    [ -s "$installer" ] || {
      printf 'Downloaded WutPack installer is empty.\n' >&2
      exit 1
    }
    /bin/bash -n "$installer" || {
      printf 'Downloaded WutPack installer is invalid.\n' >&2
      exit 1
    }
    /bin/bash "$installer" "$@"
    ;;
  python)
    [ -x "$KNOWLEDGE_ENV/bin/python" ] || { printf 'Knowledge Python is not installed. Run: wut setup\n' >&2; exit 1; }
    exec "$KNOWLEDGE_ENV/bin/python" "$@"
    ;;
  agent-python)
    [ -x "$AGENT_ENV/bin/python" ] || { printf 'Agent Python is not installed. Run: wut setup --profile full\n' >&2; exit 1; }
    exec "$AGENT_ENV/bin/python" "$@"
    ;;
  lab)
    [ -x "$KNOWLEDGE_ENV/bin/jupyter-lab" ] || { printf 'JupyterLab is not installed. Run: wut setup\n' >&2; exit 1; }
    exec "$KNOWLEDGE_ENV/bin/jupyter-lab" "$@"
    ;;
  deck)
    [ "$#" -le 1 ] || { printf 'Usage: wut deck [OUTPUT.pptx]\n' >&2; exit 2; }
    [ -f "$PROJECT_ROOT/skills/technical-deck/scripts/new_technical_deck.mjs" ] || {
      printf 'WutPack deck generator is unavailable under %s\n' "$PROJECT_ROOT" >&2
      exit 1
    }
    output="${1:-executive-consulting-demo.pptx}"
    exec node "$PROJECT_ROOT/skills/technical-deck/scripts/new_technical_deck.mjs" --output="$output"
    ;;
  security-lab)
    [ "$#" -le 1 ] || { printf 'Usage: wut security-lab [OUTPUT.html]\n' >&2; exit 2; }
    [ -f "$PROJECT_ROOT/skills/security-engineer/scripts/build_security_lab.py" ] || {
      printf 'WutPack security lab generator is unavailable under %s\n' "$PROJECT_ROOT" >&2
      exit 1
    }
    output="${1:-security-engineering-lab.html}"
    if [ -x "$KNOWLEDGE_ENV/bin/python" ]; then
      security_python="$KNOWLEDGE_ENV/bin/python"
    else
      security_python="$(command -v python3 2>/dev/null || true)"
    fi
    [ -n "$security_python" ] || { printf 'Python 3 is not installed. Run: wut setup\n' >&2; exit 1; }
    exec "$security_python" \
      "$PROJECT_ROOT/skills/security-engineer/scripts/build_security_lab.py" --output "$output"
    ;;
  diagram)
    [ "$#" -eq 2 ] || { printf 'Usage: wut diagram INPUT.mmd OUTPUT.svg\n' >&2; exit 2; }
    [ -x "$NODE_PREFIX/bin/mmdc" ] || {
      printf 'Mermaid CLI is not installed. Run: wut setup\n' >&2
      exit 1
    }
    exec "$NODE_PREFIX/bin/mmdc" -i "$1" -o "$2"
    ;;
  render)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { printf 'Usage: wut render FILE [OUTPUT_DIR]\n' >&2; exit 2; }
    soffice_bin="$(find_soffice 2>/dev/null || true)"
    [ -n "$soffice_bin" ] || { printf 'LibreOffice is not installed. Run: wut setup\n' >&2; exit 1; }
    output_dir="${2:-$(pwd)}"
    mkdir -p "$output_dir"
    render_profile="$(mktemp -d "${TMPDIR:-/tmp}/wutpack-libreoffice.XXXXXX")"
    "$soffice_bin" "-env:UserInstallation=file://$render_profile/profile" \
      --headless --convert-to pdf --outdir "$output_dir" "$1"
    render_status=$?
    case "$render_profile" in
      "${TMPDIR:-/tmp}"/wutpack-libreoffice.*) rm -rf -- "$render_profile" ;;
    esac
    exit "$render_status"
    ;;
  ocr)
    [ "$#" -eq 2 ] || { printf 'Usage: wut ocr INPUT.pdf OUTPUT.pdf\n' >&2; exit 2; }
    exec ocrmypdf --deskew --rotate-pages "$1" "$2"
    ;;
  *) printf 'Unknown command: %s\n\n' "$command_name" >&2; usage >&2; exit 2 ;;
esac
